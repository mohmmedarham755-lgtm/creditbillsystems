rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidCardFields(data) {
        return data.keys().hasAll([
            'cardName',
            'bankName',
            'last4Digits',
            'creditLimit',
            'billingCycleDay',
            'gracePeriodDays',
            'currentBalance'
          ])
          && data.keys().hasOnly([
            'cardName',
            'bankName',
            'last4Digits',
            'creditLimit',
            'billingCycleDay',
            'gracePeriodDays',
            'currentBalance'
          ])
          && data.cardName is string
          && data.bankName is string
          && data.last4Digits is string
          && data.last4Digits.matches('^[0-9]{4}$')
          && data.creditLimit is number
          && data.billingCycleDay is int
          && data.gracePeriodDays is int
          && data.currentBalance is number;
      }

      allow read, write: if isOwner();

      match /cards/{cardId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && hasValidCardFields(request.resource.data);
      }

      match /{collection}/{document=**} {
        allow read: if isOwner();
        allow write: if isOwner() && collection != 'cards';
      }
    }
  }
}
